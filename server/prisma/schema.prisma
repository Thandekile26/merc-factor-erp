generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  RECEPTION
  TECHNICIAN
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      UserRole @default(RECEPTION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String
  email       String?
  address     String?

  vehicles    Vehicle[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id            String      @id @default(cuid())

  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])

  make          String
  model         String
  year          Int
  vin           String      @unique
  registration  String      @unique
  mileage       Int

  jobCards      JobCard[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum JobStatus {
  RECEIVED
  DIAGNOSIS
  WAITING_PARTS
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  DELIVERED
}

model JobCard {
  id          String     @id @default(cuid())

  vehicleId   String
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])

  complaint   String
  diagnosis   String?
  workDone    String?

  status      JobStatus  @default(RECEIVED)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}